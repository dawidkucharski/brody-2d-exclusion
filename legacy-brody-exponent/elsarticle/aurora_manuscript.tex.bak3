    $\sqrt{2}$ & 1.8490 & 1.8477 & $+0.0013$ \\
    $e$ & 1.8488 & 1.8486 & $+0.0003$ \\
    $\sqrt{5}$ & 1.8482 & 1.8483 & $-0.0001$ \\
    $\varphi$ & 1.8477 & 1.8483 & $-0.0006$ \\
    $\sqrt{3}$ & 1.8471 & 1.8487 & $-0.0015$ \\
    $\pi$ & 1.8461 & 1.8483 & $-0.0022$ \\
